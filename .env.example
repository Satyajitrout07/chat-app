# Server Configuration
PORT=3000
NODE_ENV=development

# Relational Database (PostgreSQL / MySQL)
# Option A: Full Connection String URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chat_db
# Option B: Individual Connection Parameters
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=chat_db
DB_SSL=false

# Firebase Firestore Configuration
# Option 1: Path to Firebase Service Account JSON file (recommended for production)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Individual Service Account Credentials
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option 3: Local Firestore Emulator (for local development without cloud credentials)
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Standalone / In-Memory Mock Mode (auto enabled during 'npm test', or set to true for standalone local demo)
USE_MOCK_SERVICES=false
